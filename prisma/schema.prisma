generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String            @id @default(uuid())
  name                 String
  email                String            @unique
  emailVerified        DateTime?
  password             String?
  role                 Role              @default(User)
  subscription         Subscription      @default(NoSubscription)
  companyId            String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  image                String
  stripeCustomerId     String?           @unique
  stripeSubscriptionId String?
  stripePriceId        String?
  subscriptionStatus   String?
  accounts             Account[]
  company              Company?          @relation("CompanyOwner")
  dashboard            Dashboard?
  emails               EmailInbox[]
  payments             Payment[]
  reports              Report[]
  restaurant           Restaurant?
  restaurantQueues     RestaurantQueue?
  session              Session[]
  staffMemberships     RestaurantStaff[]
  employeeOf           Company?          @relation("CompanyEmployees", fields: [companyId], references: [id], onDelete: SetNull)
  favoriteRestaurants  SaveFavorites[]

  @@index([companyId])
}

model SaveFavorites {
  id           String @id @default(uuid())
  name         String
  restaurantID String
  userID       String
  user         User   @relation(fields: [userID], references: [id], onDelete: Cascade)
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "fk_session_user")

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Restaurant {
  id            String            @id @default(cuid())
  name          String
  description   String?
  parentCompany String
  ownerId       String            @unique
  ownerName     String
  category      String            @default("NONE")
  openingHours  Json?
  socialLinks   Json?
  contactEmail  String?
  contactPhone  String?
  website       String?
  createdAt     DateTime          @default(now())
  calendar      Calendar[]
  locations     Location[]
  menu          Menu[]
  orders        Order[]
  staff         RestaurantStaff[]
  owner         User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
}

model Calendar {
  id               String            @id @default(cuid())
  date             DateTime
  endDate          DateTime?
  eventName        String
  eventDescription String
  startTime        String?
  endTime          String?
  type             CalendarEntryType
  dishId           String?
  restaurantID     String
  restaurant       Restaurant        @relation(fields: [restaurantID], references: [id], onDelete: Cascade)
  dish             Dish?             @relation(fields: [dishId], references: [id], onDelete: SetNull)

  @@index([restaurantID])
  @@index([dishId])
}

enum CalendarEntryType {
  promotion
  event
  specialDish
}

model Location {
  id           String       @id @default(cuid())
  street       String
  houseNumber  String
  city         String
  postalCode   String
  country      String
  restaurantId String
  restaurant   Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  reservation  Reservation?

  @@index([restaurantId])
}

model Reservation {
  id          String   @id @default(cuid())
  locationId  String   @unique
  phoneNumber String
  createdAt   DateTime @default(now())
  location    Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
}

model Menu {
  id            String          @id @default(cuid())
  name          String
  description   String?
  restaurantId  String
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  bgColor       String
  fontColor     String?
  font          String
  headingFont   String?
  density       String?
  heroColor     String?
  heroTextColor String?
  categoryGroup CategoryGroup[]
  restaurant    Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
}

model Category {
  id              String        @id @default(cuid())
  name            String
  description     String?
  position        Int?
  bgColor         String?
  font            String?
  fontColor       String?
  borderRadius    String?
  elevated        Boolean       @default(true)
  leaderDots      Boolean       @default(false)
  titleAlign      String?
  titleUppercase  Boolean       @default(false)
  menuId          String?
  categoryGroupID String
  categoryGroup   CategoryGroup @relation(fields: [categoryGroupID], references: [id], onDelete: Cascade)
  dishes          Dish[]

  @@index([menuId])
  @@index([categoryGroupID])
}

model Dish {
  id              String         @id @default(cuid())
  name            String
  description     String?
  price           Decimal        @db.Decimal(10, 2)
  imageUrl        String?
  categoryId      String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  category        Category?      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  reports         Report[]
  reviews         Review[]       @relation("DishReviews")
  allergens       Allergen[]     @default([])
  stock           DishAvailable?
  calendarEntries Calendar[]

  @@index([categoryId])
}

/// Die 14 EU-Hauptallergene nach Verordnung (EU) Nr. 1169/2011
enum Allergen {
  GLUTEN
  KREBSTIERE
  EIER
  FISCH
  ERDNUESSE
  SOJA
  MILCH
  SCHALENFRUECHTE
  SELLERIE
  SENF
  SESAM
  SULFITE
  LUPINEN
  WEICHTIERE
}

enum DishAvailable {
  isAvailable
  outOfStock
}

model Order {
  id           String      @id @default(cuid())
  restaurantId String
  tableNumber  String
  items        Json
  note         String?
  status       OrderStatus @default(pending)
  createdAt    DateTime    @default(now())
  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([status])
}

enum OrderStatus {
  pending
  confirmed
  done
}

model Review {
  id        String   @id @default(cuid())
  dishId    String
  rating    Float    @default(0)
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  dish      Dish     @relation("DishReviews", fields: [dishId], references: [id], onDelete: Cascade)

  @@index([dishId])
}

model RestaurantQueue {
  id             String       @id @default(cuid())
  name           String
  description    String?
  ownerId        String       @unique
  status         String       @default("pending")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  restaurantName String
  email          String
  phoneNumber    String
  category       String
  street         String
  houseNumber    String
  city           String
  postalCode     String
  country        String
  subscription   Subscription @default(NoSubscription)
  owner          User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
}

model Company {
  id              String   @id @default(cuid())
  name            String
  stripeAccountId String?
  ownerId         String   @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  owner           User     @relation("CompanyOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  employees       User[]   @relation("CompanyEmployees")
}

model Dashboard {
  id        String   @id @default(cuid())
  userId    String   @unique
  data      Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Payment {
  id              String   @id @default(uuid())
  userId          String
  stripePaymentId String   @unique
  stripeInvoiceId String?
  stripeSessionId String?
  amount          Int
  currency        String   @default("eur")
  status          String
  description     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model StripeEvent {
  id        String   @id
  type      String
  createdAt DateTime @default(now())
}

model Report {
  id        String   @id @default(cuid())
  userId    String
  dishId    String?
  reason    String
  details   String?
  status    String   @default("open")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  dish      Dish?    @relation(fields: [dishId], references: [id])
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([dishId])
  @@index([userId])
}

model EmailInbox {
  id        String   @id @default(cuid())
  userId    String
  subject   String
  body      String
  from      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CategoryGroup {
  id           String     @id @default(cuid())
  name         String
  position     Int
  color        String
  fontColor    String?
  borderRadius String?
  titleAlign   String?    @default("left")
  menuID       String
  categories   Category[]
  Menu         Menu       @relation(fields: [menuID], references: [id], onDelete: Cascade)

  @@index([menuID])
}

enum Role {
  User
  Staff
  Admin
  Owner
  Manager
  Executive
}

enum Subscription {
  NoSubscription
  FreeTier
  Professional
  Business
}

enum StaffRole {
  manager
  waiter
  kitchen
}

model RestaurantStaff {
  id           String     @id @default(cuid())
  email        String
  userId       String?
  restaurantId String
  role         StaffRole
  approved     Boolean    @default(false)
  createdAt    DateTime   @default(now())
  user         User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([email, restaurantId])
  @@index([restaurantId])
  @@index([userId])
}
