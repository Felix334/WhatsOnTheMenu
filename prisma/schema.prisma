generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String           @id @default(uuid())
  name                 String
  email                String           @unique
  emailVerified        DateTime?
  password             String?
  role                 Role             @default(User)
  subscription         Subscription     @default(FreeTier)
  companyId            String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  image                String
  stripeCustomerId     String?          @unique
  stripeSubscriptionId String?
  stripePriceId        String?
  subscriptionStatus   String?
  accounts             Account[]
  company              Company?         @relation("CompanyOwner")
  dashboard            Dashboard?
  emails               EmailInbox[]
  payments             Payment[]
  reports              Report[]
  restaurant           Restaurant?
  restaurantQueues     RestaurantQueue?
  session              Session[]
  employeeOf           Company?         @relation("CompanyEmployees", fields: [companyId], references: [id])
  favoriteRestaurants  SaveFavorites[]

  @@index([companyId])
}

model SaveFavorites {
  id           String @id @default(uuid())
  name         String
  restaurantID String
  userID       String
  user         User   @relation(fields: [userID], references: [id])
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "fk_session_user")

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Restaurant {
  id            String     @id @default(cuid())
  name          String
  parentCompany String
  ownerId       String     @unique
  ownerName     String
  category      String     @default("NONE")
  openingHours  Json?
  socialLinks   Json?
  createdAt     DateTime   @default(now())
  calendar      Calendar[]
  locations     Location[]
  menu          Menu[]
  owner         User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
}

model Calendar {
  id               String     @id @default(cuid())
  date             DateTime
  eventName        String
  eventDescription String
  startTime        String
  endTime          String
  type             String
  restaurantID     String
  restaurant       Restaurant @relation(fields: [restaurantID], references: [id], onDelete: Cascade)
}

model Location {
  id           String       @id @default(cuid())
  street       String
  houseNumber  String
  city         String
  postalCode   String
  country      String
  restaurantId String
  restaurant   Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  reservation  Reservation?

  @@index([restaurantId])
}

model Reservation {
  id          String   @id @default(cuid())
  locationId  String   @unique
  phoneNumber String
  createdAt   DateTime @default(now())
  location    Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
}

model Menu {
  id            String          @id @default(cuid())
  name          String
  description   String?
  restaurantId  String
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  bgColor       String
  font          String
  heroColor     String?
  categoryGroup CategoryGroup[]
  restaurant    Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
}

model Category {
  id              String        @id @default(cuid())
  name            String
  description     String?
  position        Int?
  bgColor         String?
  font            String?
  fontColor       String?
  menuId          String?
  categoryGroupID String
  categoryGroup   CategoryGroup @relation(fields: [categoryGroupID], references: [id], onDelete: Cascade)
  dishes          Dish[]

  @@index([menuId])
}

model Dish {
  id          String         @id @default(cuid())
  name        String
  description String?
  price       Decimal        @db.Decimal(10, 2)
  imageUrl    String?
  categoryId  String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  category    Category?      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  reports     Report[]
  reviews     Review[]       @relation("DishReviews")
  ingredients Ingredient[]   @relation("DishIngredients")
  stock       DishAvailable?

  @@index([categoryId])
}

enum DishAvailable {
  isAvailable
  outOfStock
}

model Ingredient {
  id         String  @id @default(cuid())
  name       String
  isAllergen Boolean @default(false)
  dishes     Dish[]  @relation("DishIngredients")
}

model Review {
  id        String   @id @default(cuid())
  dishId    String
  rating    Float    @default(0)
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  dish      Dish     @relation("DishReviews", fields: [dishId], references: [id])

  @@index([dishId])
}

model RestaurantQueue {
  id             String       @id @default(cuid())
  name           String
  description    String?
  ownerId        String       @unique
  status         String       @default("pending")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  restaurantName String
  email          String
  phoneNumber    String
  category       String
  street         String
  houseNumber    String
  city           String
  postalCode     String
  country        String
  subscription   Subscription
  owner          User         @relation(fields: [ownerId], references: [id])

  @@index([ownerId])
}

model Company {
  id              String   @id @default(cuid())
  name            String
  stripeAccountId String?
  ownerId         String   @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  owner           User     @relation("CompanyOwner", fields: [ownerId], references: [id])
  employees       User[]   @relation("CompanyEmployees")
}

model Dashboard {
  id        String   @id @default(cuid())
  userId    String   @unique
  data      Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
}

model Payment {
  id              String   @id @default(uuid())
  userId          String
  stripePaymentId String   @unique
  stripeInvoiceId String?
  stripeSessionId String?
  amount          Int
  currency        String   @default("eur")
  status          String
  description     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model StripeEvent {
  id        String   @id
  type      String
  createdAt DateTime @default(now())
}

model Report {
  id        String   @id @default(cuid())
  userId    String
  dishId    String?
  reason    String
  details   String?
  status    String   @default("open")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  dish      Dish?    @relation(fields: [dishId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@index([dishId])
  @@index([userId])
}

model EmailInbox {
  id        String   @id @default(cuid())
  userId    String
  subject   String
  body      String
  from      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model CategoryGroup {
  id         String     @id @default(cuid())
  name       String
  position   Int
  color      String
  menuID     String
  categories Category[]
  Menu       Menu       @relation(fields: [menuID], references: [id], onDelete: Cascade)
}

enum Role {
  User
  Admin
  Owner
  Manager
  Executive
}

enum Subscription {
  FreeTier
  Professional
  Individuell
}
