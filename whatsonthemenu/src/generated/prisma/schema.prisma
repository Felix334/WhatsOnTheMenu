// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = "mysql://root:Neja6.pixu6@localhost:3306/RestaurantWebseite"
}

model User {
  id            String      @id @default(cuid())
  name          String
  email         String      @unique
  emailVerified DateTime?
  password      String?
  role          Role        @default(User)
  session       Session?
  restaurant    Restaurant?
  accounts      Account[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  image         String
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String? @db.Text
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum Role {
  User
  Admin
  Owner
}

model Restaurant {
  id            String     @id @default(cuid())
  name          String
  parentCompany String
  ownerId       String     @unique
  owner         User       @relation(fields: [ownerId], references: [id])
  menu          Menu[] // A restaurant can have zero or multiple menus
  locations     Location[]
  createdAt     DateTime   @default(now())
}

model Location {
  id           String       @id @default(cuid())
  street       String
  houseNumber  String
  city         String
  postalCode   String
  country      String
  restaurantId String
  restaurant   Restaurant   @relation(fields: [restaurantId], references: [id])
  reservation  Reservation?
}

model Reservation {
  id          String   @id @default(cuid())
  locationId  String   @unique
  phoneNumber String
  location    Location @relation(fields: [locationId], references: [id])
  createdAt   DateTime @default(now())
}

model Menu {
  id           String     @id @default(cuid())
  name         String
  description  String?
  restaurantId String // A menu belongs to one restaurant
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  categories   Category[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  bgColor      String
  font         String
  dishes       Dish[]
}

model Category {
  id          String  @id @default(cuid())
  name        String
  description String?
  position    Int?
  menuId      String?
  menu        Menu?   @relation(fields: [menuId], references: [id])
  dishes      Dish[]
}

model Dish {
  id          String       @id @default(cuid())
  name        String
  description String?
  price       Decimal      @db.Decimal(10, 2)
  imageUrl    String
  categoryId  String?
  menuId      String
  category    Category?    @relation(fields: [categoryId], references: [id])
  menu        Menu         @relation(fields: [menuId], references: [id])
  ingredients Ingredient[] @relation("DishIngredients")
  reviews     Review[]     @relation("DishReviews")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Ingredient {
  id         String  @id @default(cuid())
  name       String
  isAllergen Boolean @default(false)
  dishes     Dish[]  @relation("DishIngredients")
}

model Review {
  id        String   @id @default(cuid())
  dishId    String
  rating    Float    @default(0)
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  dish      Dish     @relation("DishReviews", fields: [dishId], references: [id])
}
