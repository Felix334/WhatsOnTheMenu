generator client {
  provider = "prisma-client-js"
  //output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = "mysql://root:Neja6.pixu6@localhost:3306/RestaurantWebseite"
}

model User {
  id           String      @id @default(cuid())
  name         String      @unique
  email        String      @unique
  passwordHash String
  sessionID    String?
  session      Session?    @relation(fields: [sessionID], references: [id])
  role         Role
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @default(now())
  ownerID      String?     @unique
  restaurant   Restaurant?
}

enum Role {
  User
  Admin
  Owner
}

model Session {
  id     String   @id @default(cuid())
  users  User[]
  timeIn DateTime
}

model Restaurant {
  id             String     @id @default(cuid())
  name           String
  parentCompName String
  parentCompID   String
  menuId         String     @unique
  menu           Menu?      @relation(name: "MenuRel")
  memberSince    DateTime   @default(now())
  locationID     String     @unique
  location       Location[] @relation(name: "locationRest")
  ownerID        String     @unique
  owner          User       @relation(fields: [ownerID], references: [ownerID])
}

model Location {
  id           String        @id @default(cuid())
  street       String
  houseNumber  String
  town         String
  postcode     String
  country      String
  restaurantID String        @unique
  restaurant   Restaurant    @relation(name: "locationRest", fields: [restaurantID], references: [id])
  reservierung Reservierung? @relation(name: "reservierungLoc")
}

model Reservierung {
  id           String   @id @default(cuid())
  locationID   String   @unique
  restaurantID String
  location     Location @relation(name: "reservierungLoc", fields: [locationID], references: [id])
  phoneNum     String
}

model Menu {
  id           String      @id @default(cuid())
  name         String
  description  String?
  kategorien   Kategorie[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  restaurantID String      @unique
  restaurant   Restaurant  @relation(name: "MenuRel", fields: [restaurantID], references: [id])
  bgColor      String
  font         String
}

model Kategorie {
  id          String    @id @default(cuid())
  name        String
  description String?
  menuId      String
  menu        Menu      @relation(fields: [menuId], references: [id])
  gerichte    Gericht[]
}

model Gericht {
  id          String      @id @default(cuid())
  name        String
  description String?
  price       Float
  kategorieId String
  kategorie   Kategorie   @relation(fields: [kategorieId], references: [id])
  zutaten     Zutat[]     @relation("GerichtZutaten")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  bewertungen Bewertung[] @relation("Bewertung Gericht")
  img         String
}

model Zutat {
  id         String    @id @default(cuid())
  name       String
  isAllergen Boolean   @default(false)
  gerichte   Gericht[] @relation("GerichtZutaten")
}

model Bewertung {
  id        String   @id @default(cuid())
  gerichtId String
  bewertung Int      @default(0)
  kommentar String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  gericht   Gericht  @relation("Bewertung Gericht", fields: [gerichtId], references: [id])
}
