generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = "mysql://root:Neja6.pixu6@localhost:3306/RestaurantWebseite"
}

model User {
  id         String      @id @default(cuid())
  name       String      @unique
  email      String      @unique
  password   String
  role       Role
  session    Session?
  restaurant Restaurant? // Nur Owner haben ein Restaurant
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}

enum Role {
  User
  Admin
  Owner
}

model Restaurant {
  id            String     @id @default(cuid())
  name          String
  parentCompany String
  ownerId       String     @unique
  owner         User       @relation(fields: [ownerId], references: [id])
  menuID        String
  menu          Menu?
  locations     Location[]
  createdAt     DateTime   @default(now())
}

model Location {
  id           String       @id @default(cuid())
  street       String
  houseNumber  String
  city         String
  postalCode   String
  country      String
  restaurantId String       @unique
  restaurant   Restaurant   @relation(fields: [restaurantId], references: [id])
  reservation  Reservation?
}

model Reservation {
  id          String   @id @default(cuid())
  locationId  String   @unique
  phoneNumber String
  location    Location @relation(fields: [locationId], references: [id])
  createdAt   DateTime @default(now())
}

model Menu {
  id           String     @id @default(cuid())
  name         String
  description  String?
  restaurantID String     @unique
  restaurant   Restaurant @relation(fields: [restaurantID], references: [id])
  categories   Category[]
  dishes       Dish[]
  bgColor      String
  font         String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Category {
  id          String  @id @default(cuid())
  name        String
  description String?
  menuId      String  @unique
  menu        Menu    @relation(fields: [menuId], references: [id])
  dishes      Dish[]
}

model Dish {
  id          String       @id @unique @default(cuid())
  name        String
  description String?
  price       Float
  imageUrl    String
  categoryId  String
  menuId      String
  category    Category     @relation(fields: [categoryId], references: [id])
  menu        Menu         @relation(fields: [menuId], references: [id])
  ingredients Ingredient[] @relation("DishIngredients")
  reviews     Review[]     @relation("DishReviews")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Ingredient {
  id         String  @id @default(cuid())
  name       String
  isAllergen Boolean @default(false)
  dishes     Dish[]  @relation("DishIngredients")
}

model Review {
  id        String   @id @unique @default(cuid())
  dishId    String
  rating    Float    @default(0)
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  dish      Dish     @relation("DishReviews", fields: [dishId], references: [id])
}